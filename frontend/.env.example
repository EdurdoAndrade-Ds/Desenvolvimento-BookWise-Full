# Copie para .env.local para sobrescrever os padroes sem versionar.

# Backend para onde o proxy do Vite envia '/api' durante `npm run dev`.
# Local: http://localhost:8080 | Online: https://desenvolvimento-bookwise-full.onrender.com
API_PROXY_TARGET=http://localhost:8080

# Origem da API no build (deixe vazio quando o frontend e servido pela mesma
# origem do backend; em deploy separado use a URL publica da API).
VITE_API_URL=
